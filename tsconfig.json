{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@lib/*": ["./src/lib/*"],
      "@types/*": ["./src/types/*"],
      "@config/*": ["./src/config/*"]
    }
  },
  "exclude": [
    "node_modules",
    "supabase/functions",
    "**/__mocks__",
    "**/__tests__",
    "**/*.test.ts",
    "**/*.test.tsx",
    "coverage",
    "dist",
    "web-build",
    "src/components/OptimizedImage.tsx",
    "src/components/OptimizedList.tsx",
    "src/components/DevOverlay.tsx",
    "src/components/motorista/NavigationMode.web.tsx",
    "src/components/motorista/TurnByTurnNavigation.tsx",
    "src/components/motorista/home/QuickActions.tsx"
  ]
}
