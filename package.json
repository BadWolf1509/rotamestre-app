{
  "name": "rotamestre-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node tools/scripts/copy-public.js && node tools/scripts/inject-meta-tags.js",
    "build:web:clear": "expo export --platform web --clear && node tools/scripts/copy-public.js && node tools/scripts/inject-meta-tags.js",
    "mcp:git": "node tools/mcp-git-rotamestre/src/index.js",
    "mcp:git:test": "node tools/mcp-git-rotamestre/test-mcp.js",
    "mcp:db": "node tools/mcp-server/src/index.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-google-maps/api": "^2.20.7",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@supabase/supabase-js": "^2.75.1",
    "expo": "54.0.15",
    "expo-constants": "^18.0.9",
    "expo-linking": "^8.0.8",
    "expo-location": "^19.0.7",
    "expo-router": "~6.0.13",
    "expo-status-bar": "~3.0.8",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.65.0",
    "react-native": "^0.81.4",
    "react-native-maps": "1.20.1",
    "react-native-maps-directions": "^1.9.0",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "supabase": "^2.51.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
