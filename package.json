{
  "name": "rotamestre-app",
  "version": "1.12.0",
  "androidVersionCode": 3019,
  "main": "index.ts",
  "scripts": {
    "prepare": "husky",
    "start": "expo start",
    "version:patch": "npm version patch -m \"chore(release): v%s\"",
    "version:minor": "npm version minor -m \"chore(release): v%s\"",
    "version:major": "npm version major -m \"chore(release): v%s\"",
    "version:sync": "node -e \"const pkg=require('./package.json'); const tag=require('child_process').execSync('git describe --tags --abbrev=0').toString().trim().replace('v',''); if(pkg.version!==tag){pkg.version=tag;require('fs').writeFileSync('./package.json',JSON.stringify(pkg,null,2)+'\\n');console.log('Versão atualizada para '+tag)}else{console.log('Versão já está em '+tag)}\"",
    "android": "expo run:android",
    "bump:android": "node scripts/bump-android-version-code.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "build:android:release": "npm run bump:android && cd android && gradlew.bat assembleRelease",
    "build:tokens": "node tools/scripts/build-tokens.cjs",
    "prebuild:web": "tsc --noEmit",
    "build:web": "node tools/scripts/copy-assets.js && expo export --platform web && node tools/scripts/copy-public.js && node tools/scripts/inject-meta-tags.js",
    "build:web:clear": "node tools/scripts/copy-assets.js && expo export --platform web --clear && node tools/scripts/copy-public.js && node tools/scripts/inject-meta-tags.js",
    "report:hex": "node tools/scripts/hex-report.cjs",
    "verify:design-system": "node tools/scripts/verify-design-system.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "size": "size-limit",
    "size:analyze": "size-limit --why",
    "test:verbose": "jest --verbose",
    "test:visual": "node tools/scripts/run-visual-tests.cjs",
    "test:visual:public": "node tools/scripts/run-visual-tests.cjs --public-only",
    "test:visual:update": "node tools/scripts/run-visual-tests.cjs --update",
    "test:visual:update:all": "node tools/scripts/run-visual-tests.cjs --update --all",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:report": "npx playwright show-report e2e-report",
    "type-check": "tsc --noEmit",
    "verify-ci": "node scripts/verify-ci-setup.js",
    "coverage-report": "node scripts/coverage-report.js",
    "mcp:git": "node tools/mcp-git-rotamestre/src/index.js",
    "mcp:git:test": "node tools/mcp-git-rotamestre/test-mcp.js",
    "mcp:db": "node tools/mcp-server/src/index.js",
    "migration:run": "node database/migrations/execute-migration.js",
    "migration:verify": "node database/migrations/verify-checkpoint-logic.js"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/viga": "^0.4.1",
    "@expo/log-box": "~56.0.13",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^5.4.0",
    "@mapbox/polyline": "^1.2.1",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@sentry/browser": "^10.55.0",
    "@sentry/react": "^10.55.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.106.2",
    "expo": "^56.0.0",
    "expo-asset": "~56.0.17",
    "expo-audio": "~56.0.12",
    "expo-battery": "~56.0.4",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-device": "~56.0.4",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image-manipulator": "~56.0.19",
    "expo-image-picker": "~56.0.18",
    "expo-keep-awake": "~56.0.3",
    "expo-linking": "~56.0.14",
    "expo-location": "~56.0.18",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.18",
    "expo-router": "~56.2.11",
    "expo-sharing": "~56.0.18",
    "expo-speech": "~56.0.3",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-task-manager": "~56.0.19",
    "expo-updates": "~56.0.19",
    "maplibre-gl": "^5.24.0",
    "pdfmake": "^0.3.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.76.0",
    "react-native": "0.85.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.31.2",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "~4.3.1",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-unistyles": "^3.2.5",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "web-vitals": "^5.2.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "overrides": {
    "tar": "^7.5.4"
  },
  "devDependencies": {
    "@cspell/dict-pt-br": "^2.4.2",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.0",
    "@react-native/eslint-plugin": "^0.86.0",
    "@react-native/jest-preset": "^0.85.3",
    "@size-limit/preset-app": "^12.1.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/google.maps": "^3.65.1",
    "@types/jest": "^29.5.12",
    "@types/pdfmake": "^0.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.0.7",
    "metro-minify-terser": "^0.84.4",
    "pg": "^8.21.0",
    "prettier": "^3.8.4",
    "react-test-renderer": "^19.2.3",
    "size-limit": "^12.0.0",
    "supabase": "^2.106.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
