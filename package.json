{
  "name": "rotamestre-app",
  "version": "1.15.0",
  "androidVersionCode": 3050,
  "main": "index.ts",
  "scripts": {
    "prepare": "husky",
    "postinstall": "patch-package --error-on-fail && node tools/scripts/copy-maplibre-worker.cjs && node tools/scripts/copy-assets.js",
    "start": "expo start",
    "version:patch": "npm version patch -m \"chore(release): v%s\"",
    "version:minor": "npm version minor -m \"chore(release): v%s\"",
    "version:major": "npm version major -m \"chore(release): v%s\"",
    "version:sync": "node -e \"const pkg=require('./package.json'); const tag=require('child_process').execSync('git describe --tags --abbrev=0').toString().trim().replace('v',''); if(pkg.version!==tag){pkg.version=tag;require('fs').writeFileSync('./package.json',JSON.stringify(pkg,null,2)+'\\n');console.log('Versão atualizada para '+tag)}else{console.log('Versão já está em '+tag)}\"",
    "android": "expo run:android",
    "bump:android": "node scripts/bump-android-version-code.js",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "audit:prod": "node scripts/audit-producao.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "build:android:release": "npm run bump:android && cd android && gradlew.bat assembleRelease",
    "build:tokens": "node tools/scripts/build-tokens.cjs",
    "prebuild:web": "tsc --noEmit",
    "build:web": "node tools/scripts/copy-maplibre-worker.cjs && node tools/scripts/copy-assets.js && expo export --platform web && node tools/scripts/copy-public.js && node tools/scripts/inject-meta-tags.js",
    "build:web:clear": "node tools/scripts/copy-maplibre-worker.cjs && node tools/scripts/copy-assets.js && expo export --platform web --clear && node tools/scripts/copy-public.js && node tools/scripts/inject-meta-tags.js",
    "report:hex": "node tools/scripts/hex-report.cjs",
    "scan:morto": "knip",
    "scan:morto:arquivos": "knip --include files",
    "scan:nao-declarado": "knip --include unlisted,binaries",
    "scan:morto:autoteste": "node scripts/autoteste-varredura.js",
    "verify:design-system": "node tools/scripts/verify-design-system.cjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "size": "size-limit",
    "size:analyze": "size-limit --why",
    "test:verbose": "jest --verbose",
    "test:visual": "node tools/scripts/run-visual-tests.cjs",
    "test:visual:public": "node tools/scripts/run-visual-tests.cjs --public-only",
    "test:visual:update": "node tools/scripts/run-visual-tests.cjs --update",
    "test:visual:update:all": "node tools/scripts/run-visual-tests.cjs --update --all",
    "test:e2e": "npx playwright test",
    "test:e2e:serve": "node tools/scripts/serve-dist.cjs",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "test:e2e:debug": "npx playwright test --debug",
    "test:e2e:report": "npx playwright show-report e2e-report",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm test",
    "coverage-report": "node scripts/coverage-report.js",
    "mcp:git": "node tools/mcp-git-rotamestre/src/index.js",
    "mcp:git:test": "node tools/mcp-git-rotamestre/test-mcp.js",
    "mcp:db": "node tools/mcp-server/src/index.js",
    "migration:run": "node database/migrations/execute-migration.js",
    "migration:verify": "node database/migrations/verify-checkpoint-logic.js",
    "play:status": "node scripts/play-status.mjs",
    "play:promote": "node scripts/play-promote.mjs"
  },
  "dependencies": {
    "@expo-google-fonts/nunito-sans": "^0.4.2",
    "@expo-google-fonts/viga": "^0.4.1",
    "@expo/log-box": "~58.0.14",
    "@expo/vector-icons": "^15.1.1",
    "@hookform/resolvers": "^6.0.2",
    "@mapbox/polyline": "^1.2.1",
    "@maplibre/maplibre-react-native": "^11.3.10",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.1",
    "@shopify/flash-list": "2.3.2",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.22",
    "expo-asset": "~58.0.19",
    "expo-audio": "~58.0.11",
    "expo-battery": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "expo-updates": "~58.0.20",
    "maplibre-gl": "^6.16.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
    "react-native": "0.88.1",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-toast-message": "^2.5.2",
    "react-native-ui-datepicker": "^3.3.0",
    "react-native-unistyles": "^3.7.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "overrides": {
    "tar": "^7.5.4",
    "xcode": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@cspell/dict-pt-br": "^2.4.4",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@react-native/jest-preset": "^0.88.1",
    "@size-limit/preset-app": "^14.3.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dotenv": "^18.0.9",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^14.0.3",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-expo": "~58.0.13",
    "jest-junit": "^17.0.0",
    "knip": "^6.44.0",
    "lint-staged": "^17.6.0",
    "metro-minify-terser": "^0.87.2",
    "patch-package": "^8.0.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "size-limit": "^14.0.0",
    "supabase": "^2.122.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
