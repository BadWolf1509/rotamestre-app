{
  "mcpServers": {
    "rotamestre-db": {
      "type": "stdio",
      "command": "node",
      "args": [
        "D:\\RotaMestre\\tools\\mcp-database\\src\\index.js"
      ],
      "env": {
        "SUPABASE_URL": "https://YOUR-PROJECT.supabase.co",
        "SUPABASE_SERVICE_ROLE_KEY": "YOUR-SERVICE-ROLE-KEY-HERE"
      }
    },
    "rotamestre-git-app": {
      "type": "stdio",
      "command": "node",
      "args": [
        "D:\\RotaMestre\\tools\\mcp-git-app\\src\\index.js"
      ]
    },
    "rotamestre-fs-app": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "D:\\RotaMestre\\rotamestre-app"
      ]
    }
  }
}
