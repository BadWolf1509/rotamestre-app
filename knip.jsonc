{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // ENTRY — raízes do grafo. Tudo que não é alcançável a partir daqui vira
  // "arquivo não usado", então uma raiz faltando produz FALSO POSITIVO.
  "entry": [
    // Rotas do Expo Router: são montadas por convenção de arquivo, ninguém as
    // importa. Sem esta linha, as 72 telas de app/ saem como mortas.
    "app/**/*.{ts,tsx}",

    // Variantes de plataforma. `import './MapaAdapter'` resolve para
    // MapaAdapter.tsx sob o TypeScript — quem escolhe o .web.tsx é o METRO,
    // por extensão, e o tsc não sabe disso. As 13 variantes deste repo sairiam
    // como não usadas, e são justamente as de deleção mais perigosa: quebram o
    // mapa web em silêncio (ver Armadilhas no CLAUDE.md).
    //
    // Elas entram como ENTRY, não em `ignore`, de propósito: entry preserva a
    // análise do conteúdo (export morto lá dentro ainda aparece); `ignore` as
    // tornaria cegas.
    "src/**/*.web.{ts,tsx}",
    "src/**/*.native.{ts,tsx}",

    // Raízes do Playwright e helpers de sessão.
    "e2e/**/*.{e2e,setup}.ts",

    // Chamados por `npm run`, nunca por import.
    "tools/scripts/**/*.{js,cjs,mjs}",
    "scripts/**/*.{js,mjs}",
    "*.config.{js,cjs,ts}"
  ],

  "project": ["*.{ts,tsx}", "src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}"],

  // Consumidos por CONFIG ou por CLI, nunca por import — mesma classe de falso
  // positivo das variantes de plataforma. Cada um foi conferido no arquivo que
  // o consome; não acrescente aqui sem essa conferência.
  "ignoreDependencies": [
    "@cspell/dict-pt-br", // cspell.json
    "lint-staged", // .lintstagedrc.json + .husky/pre-commit
    "supabase", // CLI: .github/workflows/expire-routes.yml

    // Heurística do plugin do Expo, a partir do app.config.js — NÃO é um
    // `import` de ninguém, e o pacote sequer está instalado. Os três
    // `backgroundColor` do config são de splash, ícone adaptativo e manifesto
    // PWA, todos servidos por outros plugins. Declarar um pacote por hipótese
    // é pior do que não declarar: some o sintoma e fica a dependência.
    "expo-system-ui",

    // Sub-pacote de @supabase/supabase-js, importado só no teste de contrato
    // de abort do PostgREST. Declará-lo é que seria arriscado: uma faixa
    // própria pode divergir da versão que o supabase-js resolve, e o teste
    // passaria a exercitar uma cópia diferente da que roda em produção.
    "@supabase/postgrest-js"
  ],

  // Binários que não vêm do npm.
  "ignoreBinaries": [
    "gradlew.bat", // nasce do `expo prebuild`; não há android/ versionado
    "start" // builtin do Windows (exec em tools/scripts/db/show-rls-fix.js)
  ],

  "jest": { "config": "jest.config.js" },
  "playwright": { "config": "playwright.config.ts" }
}
